    <!-- Weather detail descriptions -->
    <string name="uv_index_description">A measure of ultraviolet radiation from the sun. Higher values indicate a greater risk of skin damage from sun exposure (e.g., 0-2 is low risk, 8+ is very high risk).</string>
    <string name="precipitation_description">Any form of water, such as rain, snow, sleet, or hail, that falls from the sky. Usually measured in millimeters (mm).</string>
    <string name="sunrise_description">The local time when the sun first appears above the horizon, marking the start of daylight.</string>
    <string name="sunset_description">The local time when the sun drops below the horizon, marking the start of nighttime.</string>
    <string name="pressure_description">The weight of the atmosphere exerted at a given point. Normal atmospheric pressure at sea level is about 1013 hPa.</string>
    <string name="surface_pressure_description">Atmospheric pressure measured specifically at ground level, which can differ from sea level pressure due to altitude.</string>
    <string name="wind_speed_description">The rate at which air moves, measured in kilometers per hour (km/h) or meters per second (m/s).</string>
    <string name="wind_direction_description">The direction from which the wind is blowing, usually measured in degrees (0° = North, 90° = East, 180° = South, 270° = West).</string>

